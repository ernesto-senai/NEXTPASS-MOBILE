# URL da API NextPass. Com "localhost", o app funciona no navegador e, no
# celular (Expo Go, Android ou iOS), fala com a API pela porta do Expo, que
# repassa os pedidos (metro.config.js). Só mude se a API estiver em outra máquina.
EXPO_PUBLIC_API_URL=http://localhost:3333

# Celular conectado no hotspot do Windows: crie também um arquivo .env.local
# com a linha abaixo, para o QR code do Expo apontar para o computador (o
# hotspot do Windows usa sempre 192.168.137.1). O Expo só aceita essa
# variável no .env.local. No mesmo Wi-Fi do computador, não precisa.
# REACT_NATIVE_PACKAGER_HOSTNAME=192.168.137.1
