# URL da API NextPass. Com "localhost", o app funciona no navegador e, no
# celular (Expo Go, Android ou iOS), fala com a API pela porta do Expo, que
# repassa os pedidos (metro.config.js). Só mude se a API estiver em outra máquina.
EXPO_PUBLIC_API_URL=http://localhost:3333

# Para abrir no celular, use npm run celular: com o hotspot do Windows ligado,
# ele faz o QR code apontar para o hotspot (192.168.137.1) e avisa se o
# hotspot ou a API estiverem desligados. Não grave esse IP em um .env.local:
# com o hotspot desligado, o celular fica carregando para sempre.
